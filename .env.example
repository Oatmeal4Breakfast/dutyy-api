# database related info
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=dutyy
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
MAX_OVERFLOW=10
POOL_SIZE=5

#App Config
# Must exactly match the browser origin served by Caddy in dev.
FRONTEND_URL="http://localhost:8080"
ENV=development #options include (development, staging, production)
HOST="0.0.0.0"
PORT=8000
RELOAD=true

# Browser session cookie. Defaults are production-style and intentionally kept for Caddy dev:
# COOKIE_NAME="__Host-dutyy-session"
# SECURE=true
# localhost counts as a secure context in modern browsers, so the Secure cookie is stored over local HTTP.

#Resend
RESEND_API_KEY=enter-string-here
SENDER_EMAIL=test@example.com

#timedeltas in ISO 8601 standard
TOKEN_TTL=P2D

#Device Auth Config
DEVICE_AUTH_MAX_ATTEMPTS=3
DEVICE_AUTH_BASE_URI="https://localhost:8000/device"
DEVICE_AUTH_INTERVAL=5
